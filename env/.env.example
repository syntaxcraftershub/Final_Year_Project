# Copy this file to the project root as `.env` and fill in your keys.
# The real `.env` is gitignored — never commit secrets.

# Optional: stronger LLM judge backend for the Phase 4 gray-zone gate.
NVIDIA_NIM_API_KEY=your-nvidia-nim-key-here

# Optional: local Ollama (default gray-zone backend). Defaults shown.
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3.1:8b
